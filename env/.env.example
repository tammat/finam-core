# =========================================================
# Finam_Core — Production ENV Example
# =========================================================
# Русский комментарий:
# Эталонный .env для PAPER/REAL режима.
# Не хранить реальные токены в git.
# =========================================================


# =========================================================
# CORE
# =========================================================

# Режим окружения приложения.
# Значение по умолчанию: production
APP_ENV=production
# Расширенный debug-лог pipeline.
# Значение по умолчанию: 0
PIPE_DEBUG=0
# Глобальное разрешение торговли.
# Значение по умолчанию: 1
ALLOW_TRADING=1

# paper | real_dry_run | real
# Режим исполнения: paper / real_dry_run / real.
# Значение по умолчанию: paper
EXECUTION_MODE=paper

# Автоостановка pipeline через N секунд. 0 = бесконечно.
# Значение по умолчанию: 0
RUN_SECS=0


# =========================================================
# FINAM API
# =========================================================

# Токен доступа Finam API.
# Значение по умолчанию: YOUR_FINAM_TOKEN
FINAM_TOKEN=YOUR_FINAM_TOKEN
# Торговый account_id Finam.
# Значение по умолчанию: 0000000
FINAM_ACCOUNT_ID=0000000

# Категория клиента у брокера.
# Значение по умолчанию: KNUR
BROKER_CATEGORY=KNUR

# Разрешить short-позиции.
# Значение по умолчанию: 0
ALLOW_SHORT=0


# =========================================================
# MARKET DATA
# =========================================================

# Использовать SimFeed вместо реального market data.
# Значение по умолчанию: 0
SIMULATE_MARKET=0
# Принудительно разрешить торговую сессию.
# Значение по умолчанию: 0
SESSION_OVERRIDE=0
# Интервал heartbeat-логов override режима.
# Значение по умолчанию: 30
SESSION_OVERRIDE_LOG_SEC=30

# Включить синхронизацию позиций брокера.
# Значение по умолчанию: 1
ENABLE_BROKER_POSITION_SYNC=1
# Интервал sync позиций брокера.
# Значение по умолчанию: 15
BROKER_POSITION_SYNC_INTERVAL_SEC=15
# Timeout broker position sync.
# Значение по умолчанию: 10
BROKER_POSITION_SYNC_TIMEOUT_SEC=10

# Включить sync активных заявок.
# Значение по умолчанию: 1
ENABLE_BROKER_OPEN_ORDERS_SYNC=1
# Интервал sync активных заявок.
# Значение по умолчанию: 15
BROKER_OPEN_ORDERS_SYNC_INTERVAL_SEC=15


# =========================================================
# DATABASE / POSTGRESQL
# =========================================================

# Строка подключения PostgreSQL.
# Значение по умолчанию: postgresql://finam:password@localhost:5432/finam
DATABASE_URL=postgresql://finam:password@localhost:5432/finam

# Хост PostgreSQL.
# Значение по умолчанию: localhost
POSTGRES_HOST=localhost
# Порт PostgreSQL.
# Значение по умолчанию: 5432
POSTGRES_PORT=5432
# Имя БД PostgreSQL.
# Значение по умолчанию: finam
POSTGRES_DB=finam
# Пользователь PostgreSQL.
# Значение по умолчанию: finam
POSTGRES_USER=finam
# Пароль PostgreSQL.
# Значение по умолчанию: password
POSTGRES_PASSWORD=password

# Минимум соединений в пуле.
# Значение по умолчанию: 1
DB_MIN_CONN=1
# Максимум соединений в пуле.
# Значение по умолчанию: 10
DB_MAX_CONN=10


# =========================================================
# TELEGRAM
# =========================================================

# Включить Telegram уведомления.
# Значение по умолчанию: 1
ENABLE_TELEGRAM_NOTIFIER=1

# Telegram bot token.
# Значение по умолчанию: YOUR_TELEGRAM_BOT_TOKEN
TG_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
# Telegram chat_id.
# Значение по умолчанию: 000000000
TG_CHAT_ID=000000000


# =========================================================
# EXECUTION
# =========================================================

# Включить ExecutionDispatcher.
# Значение по умолчанию: 1
ENABLE_EXECUTION_DISPATCHER=1
# Разрешить live route dispatcher.
# Значение по умолчанию: 0
ENABLE_EXECUTION_DISPATCHER_LIVE_ROUTE=0

# Включить ExecutionDecision layer.
# Значение по умолчанию: 1
ENABLE_EXECUTION_DECISION_LAYER=1

# Разрешить paper fills.
# Значение по умолчанию: 1
ENABLE_PAPER_FILLS=1

# Включить OrderRouter.
# Значение по умолчанию: 1
ENABLE_ORDER_ROUTER=1
# Включить OCO order manager.
# Значение по умолчанию: 1
ENABLE_OCO_ORDER_MANAGER=1

# Остановить pipeline после первого fill.
# Значение по умолчанию: 0
EXIT_ON_FILL=0


# =========================================================
# RISK ENGINE
# =========================================================

# Soft risk mode без hard-block.
# Значение по умолчанию: 1
RISK_SOFT=1

# Максимальный дневной убыток.
# Значение по умолчанию: 5000
DAILY_LOSS_LIMIT=5000
# Максимальный риск на одну сделку.
# Значение по умолчанию: 0.01
MAX_RISK_PER_TRADE=0.01

# Порог корреляции инструментов.
# Значение по умолчанию: 0.8
CORRELATION_THRESHOLD=0.8

# Включить reconciliation gate.
# Значение по умолчанию: 1
ENABLE_BROKER_RECONCILIATION_GATE=1
# Включить hard gate позиций.
# Значение по умолчанию: 1
ENABLE_BROKER_POSITION_HARD_GATE=1
# Включить protection gate.
# Значение по умолчанию: 1
ENABLE_BROKER_PROTECTION_GATE=1

# Допустимое расхождение qty.
# Значение по умолчанию: 0.01
BROKER_RECONCILIATION_QTY_TOLERANCE=0.01
# Tolerance hard gate qty.
# Значение по умолчанию: 0.01
BROKER_POSITION_HARD_GATE_QTY_TOLERANCE=0.01


# =========================================================
# REGIME / FILTERS
# =========================================================

# Минимальный ATR % для торговли.
# Значение по умолчанию: 0.002
ATR_MIN_PCT=0.002
# Минимальная сила тренда.
# Значение по умолчанию: 0.0003
TREND_STRENGTH_MIN=0.0003
# Минимальный импульс цены.
# Значение по умолчанию: 0.0003
IMPULSE_MIN=0.0003

# Включить filter engine.
# Значение по умолчанию: 1
ENABLE_FILTER_ENGINE=1
# Включить ML layer.
# Значение по умолчанию: 0
ENABLE_ML=0


# =========================================================
# SIGNAL / ROUTER
# =========================================================

# TTL дедупликации сигналов.
# Значение по умолчанию: 2
SIGNAL_DEDUP_TTL=2
# TTL дедупликации breakout.
# Значение по умолчанию: 30
BREAKOUT_DEDUP_TTL=30

# Heartbeat блокировки intent.
# Значение по умолчанию: 300
POSITION_INTENT_BLOCK_HEARTBEAT_SEC=300


# =========================================================
# PYRAMIDING
# =========================================================

# Минимальная прибыль для pyramiding.
# Значение по умолчанию: 0.0003
PYRAMIDING_THRESHOLD=0.0003


# =========================================================
# BREAKOUT STRATEGY
# =========================================================

# Включить BR breakout strategy.
# Значение по умолчанию: 1
ENABLE_BR_CONSERVATIVE_BREAKOUT=1

# Символ breakout стратегии.
# Значение по умолчанию: BRM6@RTSX
BR_BREAKOUT_SYMBOL=BRM6@RTSX
# Размер позиции breakout.
# Значение по умолчанию: 1.0
BR_BREAKOUT_QTY=1.0

# Lookback объёма.
# Значение по умолчанию: 20
BR_VOLUME_LOOKBACK=20
# Коэффициент подтверждения объёма.
# Значение по умолчанию: 1.5
BR_VOLUME_CONFIRM_RATIO=1.5
# Максимальный volume buffer.
# Значение по умолчанию: 3.0
BR_VOLUME_BUFFER_MAX=3.0


# =========================================================
# NATURAL GAS
# =========================================================

# Основной контракт Natural Gas.
# Значение по умолчанию: NGQ6@RTSX
NG_SYMBOL=NGQ6@RTSX


# =========================================================
# REPLAY / BACKTEST
# =========================================================

# SQLite/Postgres storage bars.
# Значение по умолчанию: data/bars.sqlite
BARS_DB=data/bars.sqlite
# Таблица исторических баров.
# Значение по умолчанию: bars
BARS_TABLE=bars

# Каталог результатов backtest.
# Значение по умолчанию: reports/backtests
BACKTEST_OUTDIR=reports/backtests

# Размер chunk replay/backtest.
# Значение по умолчанию: 60
CHUNK_MINUTES=60


# =========================================================
# COMMISSIONS / SLIPPAGE
# =========================================================

# Комиссия брокера.
# Значение по умолчанию: 0.0004
COMMISSION=0.0004
# Фиксированная комиссия.
# Значение по умолчанию: 0
COMMISSION_PER_TRADE=0

# Проскальзывание исполнения.
# Значение по умолчанию: 0.0002
DEFAULT_SLIPPAGE=0.0002


# =========================================================
# FORCE / TEST MODES
# =========================================================

# Принудительный тестовый BUY signal.
# Значение по умолчанию: 0
FORCE_ONCE_BUY=0

# Dry-run execution mode.
# Значение по умолчанию: 0
DRY_RUN=0


# =========================================================
# SAFETY
# =========================================================

# Разрешить broker→PM sync.
# Значение по умолчанию: 0
ENABLE_BROKER_POSITION_APPLY_TO_PM=0

# Разрешить repair portfolio state.
# Значение по умолчанию: 0
ALLOW_PORTFOLIO_REPAIR=0


# =========================================================
# MARKET RADAR
# =========================================================

# Включить Market Radar.
# Значение по умолчанию: 0
ENABLE_MARKET_RADAR=0

# Интервал Market Radar.
# Значение по умолчанию: 300
MARKET_RADAR_INTERVAL_SEC=300


# =========================================================
# WATCHLIST
# =========================================================

# Максимум инструментов watchlist.
# Значение по умолчанию: 20
WATCHLIST_MAX_SYMBOLS=20


# =========================================================
# LOGGING
# =========================================================

# Уровень логирования.
# Значение по умолчанию: INFO
LOG_LEVEL=INFO

# Включить event store.
# Значение по умолчанию: 1
ENABLE_ORDER_EVENT_STORE=1


# =========================================================
# ML / AI
# =========================================================

# Включить AI layer.
# Значение по умолчанию: 0
ENABLE_AI_LAYER=0

# Русский комментарий:
# AI не имеет права отправлять заявки напрямую.
# Только signal advisory mode.
