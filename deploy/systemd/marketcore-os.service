[Unit]
Description=MarketCore OS UI on 8090
After=network.target postgresql.service

[Service]
Type=simple
WorkingDirectory=/opt/finam-core
Environment=PYTHONPATH=/opt/finam-core/src
ExecStart=/opt/finam-core/venv/bin/uvicorn marketcore_os.app:app --host 0.0.0.0 --port 8090
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
