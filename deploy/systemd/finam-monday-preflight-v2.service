[Unit]
Description=MarketCore Monday/weekday market-open preflight V2
After=network-online.target postgresql.service finam-paper-pipeline.service

[Service]
Type=oneshot
User=alex
WorkingDirectory=/opt/finam-core
Environment=PYTHONPATH=src
Environment=DATABASE_URL=postgresql:///finam_core
ExecStart=/opt/finam-core/venv/bin/python src/scripts/check_monday_preflight_v2.py
Nice=-5
