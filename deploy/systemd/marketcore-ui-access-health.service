[Unit]
Description=MarketCore UI internal and external access health
After=network-online.target marketcore-ui-shell.service
Wants=network-online.target
OnFailure=marketcore-ui-access-recover.service

[Service]
Type=oneshot
User=alex
WorkingDirectory=/opt/finam-core
Environment=PYTHONPATH=/opt/finam-core/src
Environment=MARKETCORE_INTERNAL_BASE_URL=http://127.0.0.1:8080
Environment=MARKETCORE_EXTERNAL_BASE_URL=http://onezh.ddns.net:18080
Environment=MARKETCORE_EXPECTED_SERVER_IP=10.0.1.3
ExecStart=/opt/finam-core/venv/bin/python src/scripts/monitor_marketcore_ui_access_v1.py
