[Unit]
Description=Finam Core Trading Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=finam
WorkingDirectory=/opt/finam-core
EnvironmentFile=/opt/finam-core/.env
ExecStart=/opt/finam-core/run.sh
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
