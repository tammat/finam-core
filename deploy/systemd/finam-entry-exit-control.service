[Unit]
Description=Finam lightweight morning entry/exit champion-challenger control
After=network.target postgresql.service

[Service]
Type=oneshot
User=alex
WorkingDirectory=/opt/finam-core
Environment=PYTHONPATH=src
Environment=ENTRY_EXIT_STAT_BOOTSTRAP_SAMPLES=1000
EnvironmentFile=/opt/finam-core/.env
ExecStart=/opt/finam-core/venv/bin/python src/scripts/run_entry_exit_control_chain_v1.py
NoNewPrivileges=true
