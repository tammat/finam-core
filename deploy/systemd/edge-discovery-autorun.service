[Unit]
Description=FinamCore Edge Discovery Autorun
After=network-online.target postgresql.service

[Service]
Type=oneshot
WorkingDirectory=/opt/finam-core
Environment=PYTHONPATH=/opt/finam-core/src
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/finam-core/venv/bin/python src/scripts/build_edge_discovery_autorun_v1.py
User=alex
Group=alex
