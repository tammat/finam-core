[Unit]
Description=Finam Core MOEX Session Paper Observation
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=finam
WorkingDirectory=/opt/finam-core
EnvironmentFile=-/opt/finam-core/.env
Environment=PYTHONPATH=/opt/finam-core/src
Environment=RUNTIME_ALLOW_TRADING=0
Environment=EXECUTION_ENABLED=0
Environment=REAL_TRADING_ENABLED=0
ExecStart=/opt/finam-core/.venv/bin/python src/scripts/research/run_moex_session_paper_observation_v1.py

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
