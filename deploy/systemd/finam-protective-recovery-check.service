[Unit]
Description=Finam Core Protective Order Recovery Check
Wants=network-online.target postgresql.service
After=network-online.target postgresql.service

[Service]
Type=oneshot
TimeoutStartSec=30
User=finam
Group=finam
WorkingDirectory=/opt/finam-core
EnvironmentFile=/opt/finam-core/deploy/env/.env
Environment=PYTHONPATH=src
ExecStart=/opt/finam-core/venv/bin/python -u src/scripts/check_protective_order_recovery.py
