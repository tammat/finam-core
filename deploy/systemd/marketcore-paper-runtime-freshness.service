[Unit]
Description=MarketCore Paper Runtime Summary Freshness V2
After=network.target postgresql.service

[Service]
Type=oneshot
User=alex
WorkingDirectory=/opt/finam-core
Environment=PYTHONPATH=/opt/finam-core/src
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=DATABASE_URL=postgresql:///finam_core
Environment=RUNTIME_ALLOW_TRADING=0
Environment=EXECUTION_ENABLED=0
Environment=REAL_TRADING_ENABLED=0
ExecStart=/opt/finam-core/venv/bin/python src/scripts/build_paper_runtime_real_data_v1.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
