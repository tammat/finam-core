[Unit]
Description=Finam Core Market Radar TOP-10 Telegram
After=network.target postgresql.service

[Service]
Type=oneshot
User=finam
WorkingDirectory=/opt/finam-core
EnvironmentFile=/opt/finam-core/.env.paper_safe
Environment=PYTHONPATH=/opt/finam-core/src
ExecStart=/opt/finam-core/venv/bin/python src/scripts/run_market_radar.py --send-telegram --telegram-top5
StandardOutput=append:/opt/finam-core/logs/market_radar_top10.log
StandardError=append:/opt/finam-core/logs/market_radar_top10.log
