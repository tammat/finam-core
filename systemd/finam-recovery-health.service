[Unit]
Description=Finam Core Recovery Orchestrator Healthcheck
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=alex
WorkingDirectory=/opt/finam-core
Environment=PYTHONPATH=src
Environment=PYTHON_BIN=/opt/finam-core/.venv/bin/python
EnvironmentFile=-/opt/finam-core/.env
ExecStart=/opt/finam-core/scripts/check_recovery_orchestrator.sh
