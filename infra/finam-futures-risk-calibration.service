[Unit]
Description=Finam daily futures Paper risk calibration advisory
After=network.target postgresql.service

[Service]
Type=oneshot
User=alex
WorkingDirectory=/opt/finam-core
Environment=PYTHONPATH=src
EnvironmentFile=/opt/finam-core/.env
ExecStart=/opt/finam-core/venv/bin/python src/scripts/analytics/build_futures_risk_calibration_v1.py
NoNewPrivileges=true
