[Unit]
Description=Finam GOLD Shadow Stability Monitor
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=alex
WorkingDirectory=/opt/finam-core
Environment=PYTHONPATH=src
EnvironmentFile=/opt/finam-core/.env
ExecStart=/opt/finam-core/venv/bin/python src/scripts/research/build_gold_shadow_stability_monitor_v1.py
NoNewPrivileges=true
