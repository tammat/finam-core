[Unit]
Description=Finam GOLD Shadow Validation
After=network.target postgresql.service

[Service]
Type=oneshot
User=alex
WorkingDirectory=/opt/finam-core
Environment=PYTHONPATH=src
Environment=GOLD_SYMBOL=GDU6@RTSX
Environment=GOLD_TIMEFRAME=M5
EnvironmentFile=/opt/finam-core/.env
ExecStart=/opt/finam-core/venv/bin/python src/scripts/research/build_runtime_shadow_validation_gold_v1.py
NoNewPrivileges=true
