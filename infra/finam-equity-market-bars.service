[Unit]
Description=Finam Equity Market Bars Backfill
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=alex
WorkingDirectory=/opt/finam-core
Environment=PYTHONPATH=src
EnvironmentFile=/opt/finam-core/.env
ExecStart=/opt/finam-core/venv/bin/python src/scripts/ingestion/backfill_equity_watch_market_bars_v1.py
NoNewPrivileges=true
