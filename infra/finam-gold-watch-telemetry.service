[Unit]
Description=Finam GOLD Watch Telemetry
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=alex
WorkingDirectory=/opt/finam-core
Environment=PYTHONPATH=src
EnvironmentFile=/opt/finam-core/.env
ExecStart=/opt/finam-core/venv/bin/python src/scripts/runtime/build_runtime_gold_watch_telemetry_v1.py
NoNewPrivileges=true
