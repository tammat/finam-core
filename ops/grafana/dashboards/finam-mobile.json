      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "\nSELECT\n    updated_at AS \"time\",\n    symbol,\n    strategy,\n    initial_qty,\n    remaining_qty,\n    tp1_done,\n    tp2_done,\n    profit_lock_done,\n    trailing_active,\n    current_stop,\n    current_take_profit\nFROM position_lifecycle_state\nORDER BY updated_at DESC\nLIMIT 100\n"
        }
