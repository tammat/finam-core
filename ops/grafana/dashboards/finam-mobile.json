    {
      "id": 1,
      "type": "timeseries",
      "title": "Trailing Stop Movement",
      "datasource": {
        "type": "postgres",
        "uid": "PBF3EFCF229E3034"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 100
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "\nSELECT\n    ts as \"time\",\n    stop_price as value,\n    symbol as metric\nFROM trailing_order_events\nWHERE $__timeFilter(ts)\n  AND action IN ('PLACE_STOP', 'REPLACE_STOP')\nORDER BY ts ASC\n"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "lineWidth": 2,
          "showPoints": "always"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Profit Lock Stop Movement",
      "datasource": {
        "type": "postgres",
        "uid": "PBF3EFCF229E3034"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 108
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "\nSELECT\n    ts AS \"time\",\n    new_stop AS value,\n    symbol AS metric\nFROM profit_lock_events\nWHERE $__timeFilter(ts)\n  AND new_stop IS NOT NULL\nORDER BY ts ASC\n"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "lineWidth": 2,
          "showPoints": "always"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
